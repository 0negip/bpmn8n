  "/api/eventlog.csv": {
   "get": {
    "operationId": "bpmn8n_api_get_event_log",
    "summary": "Get Event Log",
    "parameters": [
     {
      "in": "query",
      "name": "since",
      "schema": {
       "anyOf": [
        {
         "format": "date-time",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Since"
      },
      "required": false
     }
    ],
    "responses": {
     "200": {
      "description": "OK"
     }
    },
    "description": "Process-mining event log (PM4Py, Disco, ProM): one row per activity of each case,\nstreamed from the database.",
    "tags": [
     "observability"
    ]
   }
  },
  "/api/events": {
   "post": {
    "operationId": "bpmn8n_api_record_event",
    "summary": "Record Event",
    "parameters": [],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "title": "Response",
         "type": "object"
        }
       }
      }
     },
     "400": {
      "description": "Bad Request",
